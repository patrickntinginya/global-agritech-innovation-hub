# Copy to .env.local for local development. Never commit a real .env file.
# Only PUBLIC values go here: Vite embeds every VITE_ variable in the browser bundle.
# NEVER put the Supabase service-role key (or any secret) in a VITE_ variable.

# Supabase project URL and the anon / publishable key (Project Settings > API).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional. The public address of this site, used in auth email links (confirm / reset password).
# Leave empty to use the address the app is served from. Example: https://hub.example.org
VITE_APP_URL=
